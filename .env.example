# Supabase (https://supabase.com) — proyecto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — NUNCA exponer al cliente, solo se usa server-side
# (src/lib/supabase/service-role.ts, el webhook de Mercado Pago)
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio en producción (usada en JSON-LD, sitemap, y los
# back_urls de la preferencia de Mercado Pago)
NEXT_PUBLIC_SITE_URL=https://gemma.ar

# Mercado Pago Developers (https://www.mercadopago.com.ar/developers)
MERCADOPAGO_ACCESS_TOKEN=
# Secreto propio (elegilo vos, cualquier string largo y random) que se
# agrega como ?secret=... a la URL del webhook configurada en el panel
# de Mercado Pago — ver README para el detalle completo
MERCADOPAGO_WEBHOOK_SECRET=
