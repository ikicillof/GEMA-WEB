# Copiá este archivo a .env.local y completá los valores. NUNCA subas .env ni .env.local.
# [PÚBLICA]  = va al navegador (prefijo NEXT_PUBLIC_), no es secreta.
# [SECRETA]  = solo servidor, jamás con prefijo NEXT_PUBLIC_.

# --- Sitio ---
# URL base del sitio (local: http://localhost:3000, producción: https://tu-dominio)
SITE_URL=

# --- Rol creador ---
# Email que recibe automáticamente el rol "creador" (acceso total al panel)
CREATOR_EMAIL=

# --- Firebase (cliente) [PÚBLICAS] ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin SDK [SECRETAS] ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pegala entre comillas, con los saltos de línea como \n
FIREBASE_PRIVATE_KEY=

# --- Mercado Pago ---
# Access token (credencial de producción o de prueba) [SECRETA]
MERCADOPAGO_ACCESS_TOKEN=
# Public key para el checkout en el navegador [PÚBLICA]
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Clave secreta para validar la firma de los webhooks [SECRETA]
MERCADOPAGO_WEBHOOK_SECRET=
# true/false fuerza si las ventas y carritos de este despliegue son de prueba (se marcan con modoPrueba: true y se borran
# con "npm run limpiar:pruebas"). Si está vacío, se deduce del access token (las credenciales de prueba empiezan con TEST-).
PAGOS_MODO_PRUEBA=

# --- Correo Argentino MiCorreo (envíos) [SECRETAS] ---
MICORREO_USER=
MICORREO_PASSWORD=
# Número de cliente / customerId que te asigna MiCorreo
MICORREO_CUSTOMER_ID=
# API de MiCorreo (dejá la de producción o la de pruebas según corresponda)
# URL de la API. Pruebas: https://apitest.correoargentino.com.ar/micorreo/v1  |  Producción: https://api.correoargentino.com.ar/micorreo/v1
# Si queda vacía se usa la de PRUEBAS.
MICORREO_BASE_URL=
# Código postal (4 dígitos) desde donde despachás los paquetes
MICORREO_ORIGIN_CP=
# Poné "simulado" para forzar cotizaciones y sucursales de mentira aunque tengas credenciales
MICORREO_MODO=

# --- Resend (emails transaccionales) [SECRETAS] ---
RESEND_API_KEY=
# Remitente verificado en Resend, ej: GEMA <pedidos@tudominio.com>
RESEND_FROM_EMAIL=

# --- Novedades por email ---
# Autentica la función de fondo de Netlify que manda las novedades [SECRETA]
NOVEDADES_SECRET=
# Firma los links «Darme de baja» (mínimo 32 caracteres; si se cambia, los links de mails viejos dejan de valer) [SECRETA]
NOVEDADES_TOKEN_SECRET=
# Opcionales: límite diario de mails del plan de Resend (100 en el gratuito) y cuántos se reservan para los mails de ventas
RESEND_LIMITE_DIARIO=
NOVEDADES_RESERVA_VENTAS=

# --- Cloudinary (imágenes de productos) ---
# Nombre de la cuenta [PÚBLICA]
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Claves para subir imágenes desde el servidor [SECRETAS]
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
