{
  "name": "gemma-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "test:firebase-admin": "node --env-file=.env.local scripts/test-firebase-admin.mjs",
    "test:firebase-client": "node --env-file=.env.local scripts/test-firebase-client.mjs",
    "seed:firestore": "node --env-file=.env.local scripts/seed-firestore.mjs",
    "deploy:firestore": "firebase deploy --only firestore",
    "deploy:rules": "node --env-file=.env.local scripts/deploy-rules.mjs",
    "test:auth": "node --env-file=.env.local scripts/test-auth-flow.mjs",
    "migrar:catalogo": "tsx --env-file=.env.local scripts/migrar-catalogo.ts",
    "vincular:modelos": "tsx --env-file=.env.local scripts/vincular-modelos.ts",
    "test:checkout": "node --env-file=.env.local scripts/test-checkout.mjs",
    "test:pagos": "tsx --conditions=react-server --env-file=.env.local scripts/test-pagos.mts",
    "limpiar:pruebas": "tsx --env-file=.env.local scripts/limpiar-pruebas.ts",
    "mails:ejemplo": "tsx --tsconfig scripts/tsconfig.mails.json --env-file=.env.local scripts/mails-ejemplo.mts",
    "mails:reintentar": "tsx --tsconfig scripts/tsconfig.mails.json --env-file=.env.local scripts/mails-reintentar.mts",
    "test:novedades": "tsx --tsconfig scripts/tsconfig.mails.json --env-file=.env.local scripts/test-novedades.mts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@react-three/fiber": "^8.17.10",
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.1.13",
    "lucide-react": "0.468.0",
    "next": "^14.2.32",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "three": "^0.169.0",
    "typescript": "5.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.2",
    "@types/three": "^0.169.0",
    "autoprefixer": "10.4.19",
    "firebase-tools": "^15.34.0",
    "postcss": "8.4.40",
    "tailwindcss": "3.4.7",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "firebase-admin": {
      "jwks-rsa": "^3.2.2"
    }
